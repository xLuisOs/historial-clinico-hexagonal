# Copia este archivo como backend/.env y llena los valores.
# El .env NUNCA se sube a GitHub: las claves reales se comparten por privado.

PORT=4000
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=8h
CORS_ORIGIN=http://localhost:5173

# Motor por institución (opcional; estos son los valores por defecto)
# MOTOR_HOSPITAL=postgresql
# MOTOR_ODONTOLOGICA=firebase
# MOTOR_LABORATORIO=mongodb
# MOTOR_PEDIATRICO=mysql

# ---------------------------------------------------------------------
# Centro Pediátrico — MySQL
# ---------------------------------------------------------------------
# Opción A: Docker local (docker compose up -d)
MYSQL_ADMIN_URL=mysql://root:root_local@localhost:3307/
MYSQL_URL=mysql://pedi_app:pedi_app_local@localhost:3307/pediatrico
MYSQL_SSL_CA=
# Opción B: Azure Database for MySQL (servidor flexible). Si la clave tiene
# caracteres especiales (@ : / # ?), escríbelos con encodeURIComponent (@ → %40).
# MYSQL_SSL_CA es opcional: Node ya confía en el certificado raíz de Azure (DigiCert).
# MYSQL_ADMIN_URL=mysql://pedi_admin:CLAVE_ADMIN@hc-pediatrico-url.mysql.database.azure.com:3306/
# MYSQL_URL=mysql://pedi_app:CLAVE_APP@hc-pediatrico-url.mysql.database.azure.com:3306/pediatrico
# MYSQL_SSL_CA=

# Contraseñas de los usuarios que crea db/mysql/03_seguridad.sql
MYSQL_APP_PASSWORD=pedi_app_local
MYSQL_LECTURA_PASSWORD=pedi_lectura_local

# ---------------------------------------------------------------------
# Laboratorio — MongoDB
# ---------------------------------------------------------------------
# Opción A: Docker local (replica set de un nodo, permite transacciones)
MONGO_URL=mongodb://localhost:27018/?replicaSet=rs0&directConnection=true
# Opción B: Atlas (MONGO_URL con el usuario de la app, de rol lab_app;
# MONGO_ADMIN_URL con un usuario Atlas admin, solo para npm run db:mongo)
# MONGO_URL=mongodb+srv://lab_app:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGO_ADMIN_URL=mongodb+srv://ADMIN:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=laboratorio
# Opcional. Si Atlas falla con "querySrv ECONNREFUSED", la app ya cambia sola a
# DNS públicos. Con esta variable se fijan otros servidores (separados por coma)
# o se desactiva ese cambio con MONGO_DNS=sistema.
# MONGO_DNS=1.1.1.1,8.8.8.8

# ---------------------------------------------------------------------
# Hospital — PostgreSQL (Supabase) · Fer
# ---------------------------------------------------------------------
POSTGRES_URL=

# ---------------------------------------------------------------------
# Clínica Odontológica — Firebase · Fer
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID=
# Ruta al JSON de la cuenta de servicio (no subirlo al repo)
FIREBASE_CREDENTIALS=
